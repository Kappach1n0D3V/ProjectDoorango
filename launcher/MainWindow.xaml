<Window x:Class="ProjectDoorango.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ProjectDoorango" Width="1180" Height="820" MinWidth="1020" MinHeight="740"
 WindowStartupLocation="CenterScreen" Background="#101A19" Foreground="#F1EFE5" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#9BAEAA"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E6EDE7"/><Setter Property="Background" Value="#243734"/>
   <Setter Property="BorderBrush" Value="#3B504B"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#B8E68B"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#B8E68B"/><Setter Property="Foreground" Value="#14241D"/>
   <Setter Property="BorderBrush" Value="#B8E68B"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/>
   <Setter Property="Padding" Value="16,14"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#192724"/><Setter Property="BorderBrush" Value="#30413C"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#101A19"/><Setter Property="Foreground" Value="#F1EFE5"/>
   <Setter Property="BorderBrush" Value="#4B635A"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="CaretBrush" Value="#B8E68B"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E0E8DF"/><Setter Property="Margin" Value="0,16,0,8"/></Style>
 </Window.Resources>
 <Grid Background="#101A19">
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0C1514" BorderBrush="#263632" BorderThickness="0,0,1,0">
   <Grid Margin="18,28,18,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,32">
     <TextBlock Text="D /" FontSize="39" FontWeight="Bold" Foreground="#B8E68B"/>
     <TextBlock Text="PROJECT" FontSize="11" Foreground="#8FA69B" Margin="0,12,0,2"/>
     <TextBlock Text="DOORANGO" FontSize="20" FontWeight="Bold"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="HomeNav" Content="&#x25B7;    Play" Style="{StaticResource Nav}" Tag="Home" Click="Navigate"/>
     <Button x:Name="DownloadsNav" Content="&#x2193;    Downloads" Style="{StaticResource Nav}" Tag="Downloads" Click="Navigate"/>
     <Button x:Name="SettingsNav" Content="&#x2699;    Settings" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate"/>
     <Button x:Name="ActivityNav" Content="&#x2261;    Activity" Style="{StaticResource Nav}" Tag="Activity" Click="Navigate"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="10,0,0,0">
     <TextBlock Text="BUILT ON COMMUNITY" FontSize="10" Foreground="#718A80"/>
     <TextBlock Text="Based on ShuuuuShi’s&#x0a;Durango OffServer" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/>
     <Button Content="Credits &amp; source  ↗" Click="OpenCredits" FontSize="11" Padding="8,8"/>
     <TextBlock Text="LAUNCHER  0.1 · WINDOWS x64" FontSize="9" Foreground="#718A80" Margin="0,16,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,25,32,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22">
    <Border DockPanel.Dock="Right" Background="#1D3027" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
     <TextBlock x:Name="StatusBadge" Text="●  CHECKING SERVER" Foreground="#B8E68B" FontSize="11"/>
    </Border>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Your next expedition" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="Durango: Wild Lands  /  Community edition" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,8">
     <StackPanel x:Name="HomePage">
      <Border CornerRadius="12" Background="#243D32" ClipToBounds="True" Height="225">
       <Grid>
        <Viewbox HorizontalAlignment="Right" Width="400" Opacity="0.65">
         <Canvas Width="400" Height="225" ClipToBounds="True">
          <Ellipse Width="112" Height="112" Fill="#DBBD77" Canvas.Left="234" Canvas.Top="24"/>
          <Path Fill="#567160" Data="M0,180 L95,69 170,158 257,79 400,186 400,225 0,225 Z"/>
          <Path Fill="#314F40" Data="M0,210 L126,125 220,192 318,114 400,177 400,225 0,225 Z"/>
          <Path Fill="#173428" Data="M0,225 L0,204 100,183 230,211 400,167 400,225 Z"/>
          <Path Fill="#112A22" Data="M307,210 L307,112 281,155 298,155 277,180 301,180 301,211 Z M356,209 L356,83 323,139 344,139 320,176 348,176 348,210 Z M387,217 L387,133 364,168 380,168 361,193 381,193 381,219 Z"/>
         </Canvas>
        </Viewbox>
        <StackPanel Margin="28,24,0,22" Width="420" HorizontalAlignment="Left">
         <TextBlock Text="A WORLD WORTH RETURNING TO" Foreground="#BDCAA9" FontSize="10" FontWeight="SemiBold"/>
         <TextBlock Text="The wild is waiting." FontSize="34" FontWeight="Bold" Margin="0,12,0,7"/>
         <TextBlock Text="Build a home. Tame the unknown.&#x0a;Pick up where your adventure left off." Foreground="#CCD8C8" FontSize="14"/>
         <Button x:Name="PlayButton" Content="▶   Play Durango" Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="200" Margin="0,19,0,0" Click="Play"/>
        </StackPanel>
       </Grid>
      </Border>
      <Grid Margin="0,16,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="GAME CLIENT" FontSize="10" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="ClientStatus" Text="Installed" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,5"/>
        <TextBlock x:Name="ClientVersion" Text="Existing installation" Foreground="{StaticResource Muted}" FontSize="12"/>
        <Button Content="Manage game files  →" Margin="0,19,0,0" Tag="Downloads" Click="Navigate"/>
       </StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="LOCAL SERVER" FontSize="10" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="ServerStatus" Text="Ready to start" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,5"/>
        <TextBlock x:Name="ServerHint" Text="Your own world, on this PC" Foreground="{StaticResource Muted}" FontSize="12"/>
        <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Button x:Name="StartButton" Content="Start server" Click="StartServer"/>
         <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="StopServer"/>
        </Grid>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
       <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Padding="14,8" Click="RefreshClick"/>
        <StackPanel><TextBlock Text="CONNECTING TO" Foreground="{StaticResource Muted}" FontSize="10"/>
         <TextBlock x:Name="GatewaySummary" FontFamily="Consolas" Text="http://127.0.0.1:8190" Margin="0,6,0,0"/></StackPanel>
       </DockPanel>
      </Border>
      <TextBlock Text="First visit? Downloads has everything you need. Play can start your local server automatically." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,15,0,0"/>
     </StackPanel>
     <StackPanel x:Name="DownloadsPage" Visibility="Collapsed">
      <TextBlock Text="Everything for your expedition." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Your client, server and assets come directly from Sksandeep144/ProjectDoorango. One cached download, with every installed file verified." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="01  /  GAME CLIENT" Foreground="#B8E68B" FontSize="11"/>
       <TextBlock Text="ProjectDoorango client" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,6"/>
       <TextBlock x:Name="ReleaseInfo" Text="Check your repository for the latest client and fixes." Foreground="{StaticResource Muted}"/>
       <WrapPanel Margin="0,20,0,0"><Button x:Name="CheckButton" Content="Check for updates" Click="CheckRelease" Margin="0,0,10,0"/>
        <Button x:Name="InstallClientButton" Content="Install client" Style="{StaticResource Primary}" Click="InstallClient" IsEnabled="False"/></WrapPanel>
       <TextBlock Text="Git file hashes verified · Previous installation backed up · Account settings preserved" Foreground="#91AA97" FontSize="11" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="02  /  LOCAL SERVER &amp; ASSETS" Foreground="#B8E68B" FontSize="11"/>
       <TextBlock Text="Host your own world" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,6"/>
       <TextBlock Text="Download ProjectDoorango’s server source, terrain and data files. The bundled runtime downloads automatically on first start." Foreground="{StaticResource Muted}"/>
       <Button x:Name="InstallServerButton" Content="Download server files" HorizontalAlignment="Left" Margin="0,20,0,0" Click="InstallServer"/>
       <TextBlock Text="Existing server folders are kept intact, including your local fixes." Foreground="#91AA97" FontSize="11" Margin="0,16,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Make yourself at home." FontSize="26" FontWeight="SemiBold"/>
       <TextBlock Text="Server address" Margin="0,24,0,9"/>
       <TextBox x:Name="GatewayInput" FontFamily="Consolas"/>
       <TextBlock Text="Use http://127.0.0.1:8190 for this PC, or enter your remote server address." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
       <CheckBox x:Name="AutoStartInput" Content="Start my local server automatically when I press Play"/>
       <TextBlock Text="Your existing account= line and other game settings are preserved." Foreground="{StaticResource Muted}" FontSize="12"/>
       <Button x:Name="SaveButton" Content="Save connection settings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="SaveSettings"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="Files &amp; tools" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock x:Name="RootLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,16"/>
       <WrapPanel><Button Content="Game folder" Click="OpenGameFolder" Margin="0,0,8,8"/><Button Content="Player log" Click="OpenPlayerLog" Margin="0,0,8,8"/>
        <Button Content="Backups" Click="OpenBackups" Margin="0,0,8,8"/><Button Content="Get .NET 9 SDK ↗" Click="OpenSdk" Margin="0,0,8,8"/></WrapPanel>
       <TextBlock Text="Closing this launcher saves and stops servers it started. Servers started elsewhere stay running." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <Grid x:Name="ActivityPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="A clear view of what’s happening." FontSize="24" FontWeight="SemiBold"/>
      <DockPanel Grid.Row="1" Margin="0,16,0,16"><Button Content="Open full log" Click="OpenLauncherLog" HorizontalAlignment="Left"/>
       <TextBlock Text="Downloads, startup and server output" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
      <TextBox x:Name="LogBox" Grid.Row="2" Height="435" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
     </Grid>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#192724" BorderBrush="#30413C" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="OperationText" Text="Ready when you are." FontSize="12"/>
      <ProgressBar x:Name="Progress" Height="4" Margin="0,9,8,0" Maximum="100" Background="#2D4038" Foreground="#B8E68B" Visibility="Collapsed"/>
     </StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Padding="12,6" Margin="12,0,0,0" Visibility="Collapsed" Click="Cancel"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
