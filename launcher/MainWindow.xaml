<Window x:Class="ProjectDoorango.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ProjectDoorango" Width="1180" Height="820" MinWidth="1020" MinHeight="740"
 WindowStartupLocation="CenterScreen" Background="#11151C" Foreground="#F2F3F5" FontFamily="Segoe UI" FontSize="14" Icon="Assets/Doorango.ico" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A2ACBB"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E4E8EF"/><Setter Property="Background" Value="#242C38"/>
   <Setter Property="BorderBrush" Value="#394454"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.88"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F0BE76"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#F0BE76"/><Setter Property="Foreground" Value="#211B14"/>
   <Setter Property="BorderBrush" Value="#F0BE76"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/>
   <Setter Property="Padding" Value="16,14"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#1B212B"/><Setter Property="BorderBrush" Value="#303947"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#11151C"/><Setter Property="Foreground" Value="#F2F3F5"/>
   <Setter Property="BorderBrush" Value="#465365"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="CaretBrush" Value="#F0BE76"/>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E4E8EF"/><Setter Property="Margin" Value="0,16,0,8"/></Style>
 </Window.Resources>
 <Grid Background="#11151C">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0D1117" BorderBrush="#252D39" BorderThickness="0,0,1,0">
   <Grid Margin="18,28,18,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,36">
     <Image Source="Assets/Doorango.png" Width="54" Height="54" HorizontalAlignment="Left"/>
     <TextBlock Text="PROJECT" FontSize="10" Foreground="#8190A3" Margin="0,18,0,4"/>
     <TextBlock Text="Doorango" FontSize="25" FontWeight="SemiBold"/>
     <TextBlock Text="Your gateway to the wild." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="HomeNav" Content="&#x25B7;    Overview" Style="{StaticResource Nav}" Tag="Home" Click="Navigate"/>
     <Button x:Name="DownloadsNav" Content="&#x2193;    Downloads" Style="{StaticResource Nav}" Tag="Downloads" Click="Navigate"/>
     <Button x:Name="SettingsNav" Content="&#x2699;    Settings" Style="{StaticResource Nav}" Tag="Settings" Click="Navigate"/>
     <Button x:Name="ActivityNav" Content="&#x2261;    Troubleshooting" Style="{StaticResource Nav}" Tag="Activity" Click="Navigate"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="10,0,0,0">
     <TextBlock Text="BUILT ON COMMUNITY" FontSize="10" Foreground="#8190A3"/>
     <TextBlock Text="Based on ShuuuuShi’s&#x0a;Durango OffServer" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/>
     <Button Content="Credits &amp; source  ↗" Click="OpenCredits" FontSize="11" Padding="8,8"/>
     <TextBlock Text="WINDOWS x64  /  0.1.1" FontSize="10" Foreground="#8190A3" Margin="0,16,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,30,32,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22">
    <Border DockPanel.Dock="Right" Background="#29271F" CornerRadius="18" Padding="14,8" VerticalAlignment="Center">
     <TextBlock x:Name="StatusBadge" Text="●  CHECKING SERVER" Foreground="#F0BE76" FontSize="11"/>
    </Border>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Your next expedition" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="DURANGO: WILD LANDS" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,8">
     <StackPanel x:Name="HomePage">
      <Border CornerRadius="16" ClipToBounds="True" Height="258">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#263542" Offset="0"/><GradientStop Color="#17232D" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid>
        <Viewbox HorizontalAlignment="Right" Width="400" VerticalAlignment="Stretch" Stretch="UniformToFill" Opacity="0.85" IsHitTestVisible="False">
         <Canvas Width="400" Height="278" ClipToBounds="True">
          <Ellipse Width="124" Height="124" Fill="#E1B57B" Canvas.Left="235" Canvas.Top="30"/>
          <Path Fill="#536477" Data="M0,210 L110,76 181,166 274,66 400,190 400,278 0,278 Z"/>
          <Path Fill="#81909A" Data="M244,102 L274,66 310,112 277,98 267,112 Z"/>
          <Path Fill="#344A59" Data="M0,239 L107,148 207,225 316,142 400,218 400,278 0,278 Z"/>
          <Path Fill="#203844" Data="M0,260 L94,221 234,251 400,200 400,278 0,278 Z"/>
          <Path Fill="#12232D" Data="M305,278 L305,147 277,195 298,195 272,229 299,229 299,278 Z M360,278 L360,115 322,179 348,179 317,223 349,223 349,278 Z M392,278 L392,187 369,225 382,225 360,254 384,254 384,278 Z"/>
         </Canvas>
        </Viewbox>
        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FA202C38" Offset="0"/><GradientStop Color="#E6202C38" Offset="0.43"/><GradientStop Color="#00202C38" Offset="0.9"/></LinearGradientBrush></Border.Background></Border>
        <StackPanel Margin="30,28,0,24" Width="410" HorizontalAlignment="Left">
         <TextBlock Text="EXPLORE. BUILD. BELONG." Foreground="#F0BE76" FontSize="10" FontWeight="SemiBold"/>
         <TextBlock Text="Back to the wild." FontSize="38" FontWeight="SemiBold" Margin="0,12,0,9"/>
         <TextBlock x:Name="PlayDescription" Text="Your world is ready. Start your next adventure." Foreground="#BBC6D4" FontSize="14" MaxWidth="325" HorizontalAlignment="Left"/>
         <Button x:Name="PlayButton" Content="Play Durango  →" Style="{StaticResource Primary}" HorizontalAlignment="Left" MinWidth="204" Padding="22,14" FontSize="15" Margin="0,23,0,0" Click="Play"/>
        </StackPanel>
       </Grid>
      </Border>
      <Grid Margin="0,16,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="GAME FILES" FontSize="10" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="ClientStatus" Text="Installed" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,5"/>
        <TextBlock x:Name="ClientVersion" Text="Existing installation" Foreground="{StaticResource Muted}" FontSize="12"/>
        <Button Content="Manage installation  →" Margin="0,19,0,0" Tag="Downloads" Click="Navigate"/>
       </StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="YOUR WORLD" FontSize="10" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="ServerStatus" Text="Ready to start" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,5"/>
        <TextBlock x:Name="ServerHint" Text="Your own world, on this PC" Foreground="{StaticResource Muted}" FontSize="12"/>
        <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Button x:Name="StartButton" Content="Start server" Click="StartServer"/>
         <Button x:Name="StopButton" Grid.Column="2" Content="Save &amp; stop" Click="StopServer"/>
        </Grid>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
       <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Padding="14,8" Click="RefreshClick"/>
        <StackPanel><TextBlock Text="SERVER ADDRESS" Foreground="{StaticResource Muted}" FontSize="10"/>
         <TextBlock x:Name="GatewaySummary" FontFamily="Consolas" Text="http://127.0.0.1:8190" Margin="0,6,0,0"/></StackPanel>
       </DockPanel>
      </Border>
      <TextBlock Text="Play starts your local world automatically. Keep this launcher open while playing." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,15,0,0"/>
     </StackPanel>
     <StackPanel x:Name="DownloadsPage" Visibility="Collapsed">
      <TextBlock Text="Manage your installation." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Install for the first time from Overview, or manage individual downloads here." Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="01  /  GAME CLIENT" Foreground="#F0BE76" FontSize="11"/>
       <TextBlock Text="Game files &amp; updates" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,6"/>
       <TextBlock x:Name="ReleaseInfo" Text="Check for the latest game files and fixes on GitHub." Foreground="{StaticResource Muted}"/>
       <WrapPanel Margin="0,20,0,0"><Button x:Name="CheckButton" Content="Check for updates" Click="CheckRelease" Margin="0,0,10,0"/>
        <Button x:Name="InstallClientButton" Content="Install client" Style="{StaticResource Primary}" Click="InstallClient" IsEnabled="False"/></WrapPanel>
       <TextBlock Text="Downloads verified · Previous files backed up · Account settings kept" Foreground="#A2ACBB" FontSize="11" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="02  /  LOCAL SERVER &amp; ASSETS" Foreground="#F0BE76" FontSize="11"/>
       <TextBlock Text="Host your own world" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,6"/>
       <TextBlock Text="Required for playing on this PC. Downloads the world files and installs the runtime when you first start your server." Foreground="{StaticResource Muted}"/>
       <Button x:Name="InstallServerButton" Content="Download server files" HorizontalAlignment="Left" Margin="0,20,0,0" Click="InstallServer"/>
       <TextBlock Text="Your existing server files and saved worlds are kept." Foreground="#A2ACBB" FontSize="11" Margin="0,16,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Connection settings" FontSize="26" FontWeight="SemiBold"/>
       <TextBlock Text="Server address" Margin="0,24,0,9"/>
       <TextBox x:Name="GatewayInput" FontFamily="Consolas"/>
       <TextBlock Text="Use http://127.0.0.1:8190 for this PC, or enter your remote server address." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
       <CheckBox x:Name="AutoStartInput" Content="Start my local server automatically when I press Play"/>
       <TextBlock Text="Saving your connection keeps your existing character account settings." Foreground="{StaticResource Muted}" FontSize="12"/>
       <Button x:Name="SaveButton" Content="Save connection settings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="SaveSettings"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="Files &amp; tools" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock x:Name="RootLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,16"/>
       <WrapPanel><Button Content="Game folder" Click="OpenGameFolder" Margin="0,0,8,8"/><Button Content="Player log" Click="OpenPlayerLog" Margin="0,0,8,8"/>
        <Button Content="Backups" Click="OpenBackups" Margin="0,0,8,8"/><Button Content="Developer SDK ↗" Click="OpenSdk" Margin="0,0,8,8"/></WrapPanel>
       <TextBlock Text="Closing this launcher saves and stops servers it started. Servers started elsewhere stay running." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <Grid x:Name="ActivityPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Launcher activity" FontSize="24" FontWeight="SemiBold"/>
      <DockPanel Grid.Row="1" Margin="0,16,0,16"><Button Content="Open full log" Click="OpenLauncherLog" HorizontalAlignment="Left"/>
       <TextBlock Text="Details to help diagnose downloads and connection issues" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/></DockPanel>
      <TextBox x:Name="LogBox" Grid.Row="2" Height="435" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
     </Grid>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#1B212B" BorderBrush="#303947" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="OperationText" Text="Ready when you are." FontSize="12"/>
      <ProgressBar x:Name="Progress" Height="4" Margin="0,9,8,0" Maximum="100" Background="#303947" Foreground="#F0BE76" Visibility="Collapsed"/>
     </StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Padding="12,6" Margin="12,0,0,0" Visibility="Collapsed" Click="Cancel"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
